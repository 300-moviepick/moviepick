# moviepick 로컬 개발 환경 설정
# 이 파일을 같은 폴더(프로젝트 맨 위)에 .env 로 복사해서 쓴다. .env는 저장소에 올라가지 않는다.
#   Windows PowerShell: Copy-Item .env.example .env
#   Mac·Linux:          cp .env.example .env
# docker compose와 Spring 앱이 같은 .env를 읽는다.
#
# 작성 규칙
# - 값에 따옴표를 쓰지 않는다.            (O) JWT_SECRET=abc   (X) JWT_SECRET="abc"
# - = 앞뒤에 공백을 넣지 않는다.          (O) MYSQL_PORT=3307  (X) MYSQL_PORT = 3307
# - DB 비밀번호(MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD)는 바꾸지 말고 그대로 쓴다.
#   바꾸면 이미 만들어진 DB와 맞지 않아 docker compose down -v 후 다시 만들어야 한다.

# ---------- Docker MySQL (개발용 예시값, 로컬 PC에서만 접속 가능) ----------
MYSQL_ROOT_PASSWORD=moviepick-root-local
MYSQL_DATABASE=moviepick
MYSQL_USER=moviepick
MYSQL_PASSWORD=moviepick-local
# PC에 설치된 MySQL(3306)과 겹치지 않게 3307을 쓴다
MYSQL_PORT=3307

# ---------- Docker Redis ----------
# PC에 설치된 Redis와 겹치지 않게 6380을 쓴다
REDIS_PORT=6380

# ---------- 비밀값 (빈 칸으로 두고 각자 채운다. 절대 저장소에 올리지 않는다) ----------
# JWT 서명 키: Base64 문자열, 디코딩 후 32바이트 이상
JWT_SECRET=
# TMDB API 읽기 액세스 토큰: 영화 데이터 수집용 (TMDB 사이트 > 설정 > API)
TMDB_ACCESS_TOKEN=
# PortOne 결제 (테스트 채널): 후원·AI 크레딧 결제용 (PortOne 콘솔)
#   PortOne 콘솔의 웹훅 주소는 {서버 주소}/api/webhooks/portone (후원·AI 크레딧 공통)
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=
# 소셜 로그인: 카카오 개발자 콘솔 / Google Cloud 콘솔
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OpenAI API 키: AI 추천·임베딩을 켤 때만 필요하다 (AI_*_PROVIDER=openai)
OPENAI_API_KEY=

# ---------- 아래는 기본값이 있는 설정 (적힌 값이 application.yml 기본값과 같다) ----------
# 주의: 값을 빈 칸으로 두면 기본값 대신 빈 값이 들어가 기동에 실패할 수 있다. 쓰지 않으면 줄을 지운다.

# AI 기능 스위치: none(끔) 또는 openai. 둘 다 none이면 OpenAI를 전혀 호출하지 않는다
#   AI_CHAT_PROVIDER: 추천 API와 크레딧 구매 시작 API 등록 여부
#   AI_EMBEDDING_PROVIDER: 의미 검색(임베딩) 사용 여부
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
# OpenAI 채팅: 모델, 응답 최대 토큰, 요청 제한 시간, 라이브러리 재시도 횟수
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MAX_COMPLETION_TOKENS=1000
OPENAI_CHAT_TIMEOUT=15s
OPENAI_CHAT_MAX_RETRIES=0
# OpenAI 임베딩: 모델, 차원(movie_embeddings 테이블과 같아야 함), 요청 제한 시간, 재시도 횟수
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
OPENAI_EMBEDDING_TIMEOUT=15s
OPENAI_EMBEDDING_MAX_RETRIES=0

# 프론트 주소: 소셜 로그인 후 이동할 주소, CORS 허용 주소(여러 개면 쉼표로 구분)
APP_FRONTEND_URL=http://localhost:5173
APP_FRONTEND_ALLOWED_ORIGINS=http://localhost:5173
# refresh 토큰 쿠키의 Secure 속성: 로컬(http)은 false, HTTPS 운영은 true
APP_COOKIE_SECURE=false

# 영화 정기 수집 배치 (README의 '정기 수집' 참고)
MOVIE_BATCH_SCHEDULER_ENABLED=false
MOVIE_BATCH_SCHEDULER_CRON=0 0 3 * * *
MOVIE_BATCH_COLLECT_PAGES=1
