# moviepick 운영(EC2) 환경 설정 예시
# EC2의 프로젝트 맨 위에서 이 파일을 .env로 복사해 채운다: cp .env.prod.example .env
# docker-compose.prod.yml과 Spring 앱(prod 프로필)이 같은 .env를 읽는다. .env는 저장소에 올리지 않는다.
#
# 작성 규칙 (로컬 .env.example과 같다)
# - 값에 따옴표를 쓰지 않고, = 앞뒤에 공백을 넣지 않는다.
# - 빈 칸으로 남기지 않는다. 특히 기본값이 있는 변수를 KEY= 처럼 빈 값으로 두면 기본값 대신
#   빈 값이 들어가 기동에 실패할 수 있다. 쓰지 않는 변수는 줄을 지운다.
# - MYSQL_PORT, REDIS_PORT는 운영에서 쓰지 않는다 (컨테이너끼리 내부 포트로 접속).
# - 비밀번호·키는 로컬과 다른 새 값을 쓴다. 채팅·문서·커밋에 적지 않는다.

# ---------- MySQL (처음 compose 실행 때 이 값으로 DB가 만들어진다. 이후 바꾸지 않는다) ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=moviepick
MYSQL_USER=moviepick
MYSQL_PASSWORD=

# ---------- 도메인 (Caddy가 이 주소로 인증서를 발급받는다) ----------
API_DOMAIN=api.moviepick.kr

# ---------- 비밀값 (반드시 채운다) ----------
# JWT 서명 키: Base64 문자열, 디코딩 후 32바이트 이상. 로컬과 다른 값
JWT_SECRET=
# TMDB API 읽기 액세스 토큰
TMDB_ACCESS_TOKEN=
# PortOne 결제 (테스트 채널 유지)
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
# PortOne 콘솔에 웹훅 주소 https://api.moviepick.kr/api/webhooks/portone 를 등록할 때 발급되는 시크릿 (whsec_로 시작)
# 등록 전에는 이 줄을 지운다 (비어 있어도 앱은 뜨지만 웹훅은 모두 거부된다)
PORTONE_WEBHOOK_SECRET=
# 소셜 로그인 (콘솔 Redirect URI: https://www.moviepick.kr/login/oauth2/code/kakao, .../google)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OpenAI API 키: 운영용으로 따로 발급 (선불 충전, 자동 충전 끔)
OPENAI_API_KEY=

# ---------- 운영 값이 정해진 설정 (그대로 둔다) ----------
# AI 켬: none 또는 openai (키가 아님)
AI_CHAT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai
# 프론트 주소: 소셜 로그인 후 이동·소셜 로그인 콜백·CORS 허용 주소
APP_FRONTEND_URL=https://www.moviepick.kr
APP_FRONTEND_ALLOWED_ORIGINS=https://www.moviepick.kr
# refresh 토큰 쿠키 Secure (HTTPS)
APP_COOKIE_SECURE=true
# 영화 정기 수집 배치 켬 (매일 03:00, 1페이지)
MOVIE_BATCH_SCHEDULER_ENABLED=true

# OPENAI_* 모델·토큰·시간·재시도, MOVIE_BATCH_SCHEDULER_CRON, MOVIE_BATCH_COLLECT_PAGES는
# 기본값을 쓰므로 적지 않는다. 바꿀 때만 값과 함께 줄을 추가한다 (OPENAI_EMBEDDING_DIMENSIONS=768 변경 금지)
